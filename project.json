{
  "name": "@udp",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "generate:openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm generate:openapi",
        "cwd": "cdk"
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm generate:openapi && pnpm serve:openapi",
        "cwd": "cdk"
      }
    },

    "set-developer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/set-developer.sh",
        "cwd": "."
      },
      "cache": true
    },

    "lint": {
      "executor": "@nx/eslint:lint",
      "cache": true,
      "options": {
        "lintFilePatterns": [ "{projectRoot}/**/*.{ts,js}" ],
        "eslintConfig": "./.eslintrc.json",
        "env": { "NODE_OPTIONS": "--max-old-space-size=8192" }
      }
    }
  }
}

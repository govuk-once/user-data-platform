{
  "name": "@udp",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "set-developer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/set-developer.sh",
        "cwd": "."
      },
      "cache": true
    },
    "teardown": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run @tf/dynamodb:destroy",
          "nx run @tf/kms:destroy",
          "nx run @tf/cognito:destroy"
        ],
        "parallel": false
      }
    }
  }
}

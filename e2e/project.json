{
  "name": "@test/e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "e2e",
  "projectType": "application",
  "tags": ["type:e2e"],
  "targets": {
    "extract-env": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/extract-cdk-outputs.sh --personal",
        "cwd": "e2e"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["@test/e2e:extract-env"],
      "options": {
        "command": "node --import tsx/esm ../node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.cjs",
        "cwd": "e2e"
      }
    },
    "pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx/esm ../node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.cjs",
        "cwd": "e2e"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["echo 'Deployment complete'"],
        "cwd": "e2e",
        "parallel": false
      }
    },
    "deploy-and-test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run cdk:deploy",
          "nx run @test/e2e:e2e",
          "nx run cdk:destroy",
          "rm -f .env"
        ],
        "cwd": "e2e",
        "parallel": false
      }
    }
  }
}

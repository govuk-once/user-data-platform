{
  "name": "@src/admissionReconcillerLambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VITEST_COVERAGE_DIR=coverage/admissionReconcillerLambda vitest run src/admissionReconcillerLambda/*"
      }
    },
    "build": {
      "dependsOn": ["typecheck", "test"],
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{option.outputPath}"],
      "options": {
        "main": "src/admissionReconcillerLambda/handler.ts",
        "tsConfig": "src/admissionReconcillerLambda/tsconfig.json",
        "outputPath": "build/admissionReconcillerLambda",
        "minify": true,
        "bundle": true,
        "thirdParty": true,
        "platform": "node",
        "declaration": false,
        "target": "node20",
        "format": ["cjs"],
        "external": ["@aws-sdk/*"],
        "skipTypeCheck": true,
        "esbuildOptions": {
          "outfile": "./build/admissionReconcillerLambda/index.js"
        }
      }
    }
  }
}

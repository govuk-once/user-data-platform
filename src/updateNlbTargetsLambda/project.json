{
  "name": "@src/updateNlbTargetsLambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "dependsOn": ["typecheck", "test"],
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{option.outputPath}"],
      "options": {
        "main": "src/updateNlbTargetsLambda/handler.ts",
        "tsConfig": "src/updateNlbTargetsLambda/tsconfig.json",
        "outputPath": "build/updateNlbTargetsLambda",
        "minify": true,
        "bundle": true,
        "thirdParty": true,
        "platform": "node",
        "declaration": false,
        "target": "node20",
        "format": ["cjs"],
        "external": ["@aws-sdk/*"],
        "skipTypeCheck": true,
        "esbuildOptions": {
          "outfile": "./build/updateNlbTargetsLambda/index.js"
        }
      }
    }
  }
}

{
  "name": "cdk",
  "$schema": "../node_modules/nk/schemas/project-schema.json",
  "sourceRoot": "cdk",
  "implicitDependencies": [
    "@src/createUserLambda",
    "@src/deleteDataLambda",
    "@src/postDataLambda",
    "@src/getDataLambda",
    "@src/createIdentityLambda",
    "@src/readIdentityLambda",
    "@src/deleteIdentityLambda",
    "@src/startDsarLambda",
    "@src/dsarRequestLambda",
    "@src/dsarDeleteLambda"
  ],
  "targets": {
    "diff": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "DEVELOPER_ID=$(./scripts/set-developer.sh --value) npx cdk diff",
        "cwd": "cdk"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "DEVELOPER_ID=$(./scripts/set-developer.sh --value) npx cdk deploy --all -c env=dev --require-approval never",
        "cwd": "cdk"
      }
    },

    "deploy:dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx cdk deploy --all -c env=dev --require-approval never",
        "cwd": "cdk"
      }
    },

    "deploy:stag": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx cdk deploy --all -c env=stag --require-approval never",
        "cwd": "cdk"
      }
    },

    "deploy:prod": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx cdk deploy --all -c env=prod --require-approval never",
        "cwd": "cdk"
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DEVELOPER_ID=$(./scripts/set-developer.sh --value) npx cdk destroy --all -c env=dev --force",
        "cwd": "cdk"
      }
    },

    "destroy:dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx cdk destroy --exclusively \"$DEVELOPER_ID-dev-perf\" \"$DEVELOPER_ID-dev-e2e\" \"$DEVELOPER_ID-dev-monitoring\" \"$DEVELOPER_ID-dev-main\" \"$DEVELOPER_ID-dev-dsar\" -c env=dev --force",
        "cwd": "cdk"
      }
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk bootstrap",
        "cwd": "cdk"
      }
    }
  }
}

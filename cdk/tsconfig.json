{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "emitDeclarationOnly": false,
        "outDir": "dist",
        "rootDir": ".",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "lib": ["es2022"],
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noImplicitThis": true
    },
    "include": ["bin/**/*ts", "lib/**/*.ts", "constants/**/*.ts"],
    "exclude": ["node_modules", "dist", "cdk.out"]
}
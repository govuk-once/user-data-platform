{
  "name": "user-data-platform",
  "version": "1.25.1",
  "team": "udp",
  "repository": {
    "type": "git",
    "url": "https://github.com/govuk-once/user-data-platform.git"
  },
  "scripts": {
    "prepare": "git config core.hooksPath git-hooks",
    "test:all": "npx nx run-many --target=test",
    "test:affected": "npx nx affected --target=test",
    "build:all": "npx nx run-many --target=build",
    "build:affected": "npx nx affected --target=build",
    "lint:all": "npx nx run-many --target=lint",
    "lint:affected": "npx nx affected --target=lint --outputStyle static",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "serve:openapi": "npx serve docs"
  },
  "devDependencies": {
    "@nx/esbuild": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/vite": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.15.26",
    "@swc/helpers": "~0.5.11",
    "@types/aws-lambda": "8.10.159",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-v8": "4.0.9",
    "aws-cdk": "^2.1034.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "esbuild": "0.27.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "nx": "22.3.3",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.9"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-lambda-powertools/parameters": "^2.33.0",
    "@aws-lambda-powertools/tracer": "^2.33.0",
    "@aws-sdk/client-backup": "^3.1045.0",

{
  "name": "user-data-platform",
  "version": "1.25.1",
  "team": "udp",
  "packageManager": "pnpm@10.26.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/govuk-once/user-data-platform.git"
  },
  "scripts": {
    "prepare": "git config core.hooksPath git-hooks",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:all": "VITEST_COVERAGE_DIR=coverage/unit vitest run src libs",
    "build:lambdas": "node scripts/build-lambdas.mjs",
    "build:perf": "node performance/scripts/build.mjs",
    "build:all": "pnpm typecheck && pnpm test:all && pnpm build:lambdas && pnpm build:perf",
    "lint:all": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.js",
    "format:write": "npx prettier --log-level warn --write .",
    "format:check": "npx prettier --check .",
    "cdk:diff": "pnpm build:all && cd cdk && DEVELOPER_ID=$(./scripts/set-developer.sh --value) npx cdk diff",
    "cdk:deploy": "pnpm build:all && cd cdk && DEVELOPER_ID=$(./scripts/set-developer.sh --value) npx cdk deploy --all -c env=dev --require-approval never",
    "cdk:deploy:dev": "pnpm build:all && cd cdk && npx cdk deploy --all -c env=dev --require-approval never",
    "cdk:deploy:stag": "pnpm build:all && cd cdk && npx cdk deploy --all -c env=stag --require-approval never",
    "cdk:deploy:prod": "pnpm build:all && cd cdk && npx cdk deploy --all -c env=prod --require-approval never",
    "cdk:destroy": "cd cdk && DEVELOPER_ID=$(./scripts/set-developer.sh --value) npx cdk destroy --all -c env=dev --force",
    "cdk:destroy:dev": "pnpm build:all && cd cdk && npx cdk destroy --exclusively \"$DEVELOPER_ID-dev-perf\" \"$DEVELOPER_ID-dev-e2e\" \"$DEVELOPER_ID-dev-monitoring\" \"$DEVELOPER_ID-dev-sar\" \"$DEVELOPER_ID-dev-dsar\" \"$DEVELOPER_ID-dev-dvla-pilot\" \"$DEVELOPER_ID-dev-main\" -c env=dev --force",
    "cdk:bootstrap": "cd cdk && npx cdk bootstrap",
    "e2e": "npm --prefix e2e run e2e --",
    "e2e:deploy-and-test": "pnpm cdk:deploy && pnpm e2e && pnpm cdk:destroy && rm -f e2e/.env",
    "perf": "npm --prefix performance run",
    "set-developer": "./cdk/scripts/set-developer.sh",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "serve:openapi": "npx serve docs",
    "openapi": "pnpm generate:openapi && pnpm serve:openapi",
    "security-scan": "pnpm build:all && npx cdk synth --quiet -o cdk/cdk.out && checkov -d cdk/cdk.out --config-file cdk/.checkov.yaml -o json --output-file-path cdk/checkov-results.json",
    "semantic:release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.15.26",
    "@swc/helpers": "~0.5.11",
    "@types/aws-lambda": "8.10.159",
    "@types/k6": "^1.7.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-v8": "4.0.9",
    "aws-cdk": "^2.1140.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "k6": "^0.0.0",
    "prettier": "3.6.2",
    "semantic-release": "^25.0.5",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/logger": "^2.33.1",
    "@aws-lambda-powertools/parameters": "^2.33.1",
    "@aws-lambda-powertools/tracer": "^2.33.1",
    "@aws-sdk/client-backup": "^3.1026.0",
    "@aws-sdk/client-dynamodb": "^3.940.0",
    "@aws-sdk/client-ec2": "^3.976.0",
    "@aws-sdk/client-iam": "^3.1026.0",
    "@aws-sdk/client-kms": "^3.993.0",
    "@aws-sdk/client-s3": "^3.993.0",
    "@aws-sdk/client-secrets-manager": "^3.975.0",
    "@aws-sdk/client-sqs": "^3.999.0",
    "@aws-sdk/credential-providers": "^3.975.0",
    "@aws-sdk/lib-dynamodb": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.993.0",
    "@cucumber/cucumber": "^12.3.0",
    "@middy/core": "^6.4.5",
    "@middy/http-json-body-parser": "^6.4.5",
    "@middy/http-response-serializer": "^6.4.5",
    "@smithy/protocol-http": "^5.3.13",
    "@smithy/signature-v4": "^5.3.8",
    "@smithy/types": "^4.14.1",
    "aws-cdk-lib": "^2.256.1",
    "aws-lambda": "^1.0.7",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.6.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.2.1"
  },
  "workspaces": [
    "libs/*",
    "cdk/*"
  ]
}

{
  "name": "@tf/cognito",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [],
  "targets": {
    "init": {
      "dependsOn": ["@udp:set-developer"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/cognito && terraform init --backend-config='backend.tfvars' --reconfigure"
      }
    },
    "plan": {
      "dependsOn": ["init"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/cognito && terraform plan -out tfplan"
      }
    },
    "apply": {
      "dependsOn": ["plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/cognito && terraform apply tfplan"
      }
    }
  }
}

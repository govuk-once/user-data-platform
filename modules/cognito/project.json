{
    "name": "@tf/cognito",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "implicitDependencies": [],
    "targets": {
        "init": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cd ./modules/cognito && terraform init"
            }
        },
        "plan": {
            "dependsOn": ["^build"],
            "executor": "nx:run-commands",
            "options": {
                "command": "cd ./modules/cognito && terraform plan"
            }
        },
        "apply": {
            "dependsOn": ["^build"],
            "executor": "nx:run-commands",
            "options": {
                "command": "cd ./modules/cognito && terraform apply -auto-approve"
            }
        }
    }
}
{
  "name": "@tf/getDataLambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "@src/getDataLambda",
    "@tf/cognito",
    "@tf/api-gateway",
    "@tf/dynamodb"
  ],
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/getData-lambda && terraform init"
      }
    },
    "plan": {
      "dependsOn": ["^build", "^apply", "init"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/getData-lambda && terraform plan"
      }
    },
    "apply": {
      "dependsOn": ["^build", "plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/getData-lambda && terraform apply -auto-approve"
      }
    }
  }
}

{
  "name": "@tf/getDataLambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["@src/getDataLambda", "@tf/cognito", "@tf/api-gateway"],
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/getData-lambda && terraform init"
      }
    },
    "plan": {
      "dependsOn": ["^build", "plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/getData-lambda && terraform plan"
      }
    },
    "apply": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/getData-lambda && terraform apply -auto-approve"
      }
    }
  }
}

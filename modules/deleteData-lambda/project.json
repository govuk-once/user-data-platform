{
  "name": "@tf/deleteDataLambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "@src/deleteDataLambda",
    "@tf/cognito",
    "@tf/api-gateway",
    "@tf/dynamodb",
    "@tf/kms"
  ],
  "targets": {
    "init": {
      "dependsOn": ["@udp:set-developer"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/deleteData-lambda && terraform init --backend-config='backend.tfvars' -reconfigure"
      }
    },
    "plan": {
      "dependsOn": ["^build", "^apply", "init"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/deleteData-lambda && terraform plan -out=tfplan"
      }
    },
    "apply": {
      "dependsOn": ["^build", "plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/deleteData-lambda && terraform apply tfplan"
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/deleteData-lambda && terraform destroy -auto-approve"
      }
    }
  }
}

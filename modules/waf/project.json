{
  "name": "@tf/waf",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["@tf/api-gateway"],
  "targets": {
    "init": {
      "dependsOn": ["@udp:set-developer"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/waf && terraform init --backend-config='backend.tfvars' -reconfigure"
      }
    },
    "plan": {
      "dependsOn": ["init"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/waf && terraform plan -out=tfplan"
      }
    },
    "apply": {
      "dependsOn": ["plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/waf && terraform apply tfplan"
      }
    },
    "destroy": {
      "dependsOn": ["plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/waf && terraform destroy -auto-approve"
      }
    }
  }
}

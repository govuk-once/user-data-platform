{
  "name": "@tf/postDataLambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "@src/postDataLambda",
    "@tf/cognito",
    "@tf/api-gateway",
    "@tf/dynamodb"
  ],
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/postData-lambda && terraform init"
      }
    },
    "plan": {
      "dependsOn": ["^build","^apply","init"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/postData-lambda && terraform plan"
      }
    },
    "apply": {
      "dependsOn": ["plan"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/postData-lambda && terraform apply -auto-approve"
      }
    }
  }
}

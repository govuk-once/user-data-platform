{
  "name": "@tf/api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["@tf/cognito"],
  "targets": {
    "init": {
      "dependsOn": ["@udp:set-developer"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform init --backend-config='backend.tfvars' -reconfigure"
      }
    },
    "plan": {
      "dependsOn": ["init", "^apply"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform plan -out=tfplan"
      }
    },
    "apply": {
      "dependsOn": ["plan", "^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform apply tfplan"
      }
    },
    "destroy": {
      "dependsOn": ["@tf/getDataLambda:destroy", "@tf/postDataLambda:destroy"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform destroy -auto-approve"
      }
    }
  }
}

{
  "name": "@tf/api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "@tf/cognito"
  ],
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform init"
      }
    },
    "plan": {
      "dependsOn": ["init", "^apply"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform plan"
      }
    },
    "apply": {
      "dependsOn": ["plan", "^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./modules/api-gateway && terraform apply -auto-approve"
      }
    }
  }
}

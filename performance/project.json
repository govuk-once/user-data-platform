{
  "name": "@test/performance",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "performance/src",
  "projectType": "application",
  "tags": ["type:performance"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build.mjs",
        "cwd": "performance"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "k6 run dist/smoke-test.js",
        "cwd": "performance"
      }
    },
    "baseline": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "k6 run dist/scenarios/baseline.js",
        "cwd": "performance"
      }
    },
    "read-heavy-spike": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "k6 run dist/scenarios/read-heavy-spike.js",
        "cwd": "performance"
      }
    },
    "stress-reads": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "k6 run dist/scenarios/stress-reads.js",
        "cwd": "performance"
      }
    },
    "stress-writes": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "k6 run dist/scenarios/stress-writes.js",
        "cwd": "performance"
      }
    },
    "stress-deletes": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "k6 run dist/scenarios/stress-deletes.js",
        "cwd": "performance"
      }
    }
  }
}

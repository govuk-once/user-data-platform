{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
  "@libs/utils/logger": ["libs/utils/logger/src/Logger.ts"],
  "@libs/*": ["libs/*/src"],
  "@modules/*": ["modules/*/src"]
}
  },
  "exclude": ["node_modules", "tmp"],
  "include": ["libs", "src"]
}
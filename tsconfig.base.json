{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@libs/data-access": ["libs/data-access/index.ts"],
      "@libs/utils": ["libs/utils/index.ts"],
      "@libs/*": ["libs/*/src"],
      "@modules/*": ["modules/*/src"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
